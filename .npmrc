# Supply-chain hardening: pin exact versions, and fail the install if any
# dependency has install scripts not listed in package.json "allowScripts"
# (pinned to reviewed versions: esbuild, workerd only). Older npm releases
# ignore "allowScripts", so engine-strict refuses to install with npm < 11.19.
save-exact=true
fund=false
strict-allow-scripts=true
engine-strict=true
